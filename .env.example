# Все переменные ниже необязательные, кроме отмеченных. Сервис поднимается с
# пустым .env: значения по умолчанию рассчитаны на одну машину с одной картой.
#
# Здесь НЕ перечислены GPU_DEVICES и COMFYUI_URLS: их пишет
# gen-gpu-override.sh в docker-compose.override.yml по числу карт. Править их
# руками смысла нет, перегенерируй скриптом.


# --------------------------------------------------------------------------
#  Ключи
# --------------------------------------------------------------------------

# Токен HuggingFace: снимает rate-limit при холодной закачке весов.
HF_API_KEY=

# Ключ civitai: без него скачивание LoRA отдаёт 401 ("requires you to be
# logged in"). Берётся в профиле civitai -> API Keys. Нужен только когда
# качаешь новую LoRA; на работу сервиса не влияет.
CIVIT_AI_API_KEY=


# --------------------------------------------------------------------------
#  Учёт задач и статистика
# --------------------------------------------------------------------------

# Имя ЭТОГО узла: попадает в статистику и в ключи карт ("узел:номер").
# Пусто — берётся hostname. Стоит задать осмысленно, иначе в графиках будут
# имена контейнеров.
NODE_NAME=

# Куда экспортёр отвозит строки для дашборда. ПУСТО — экспорт выключен, и это
# рабочий режим, а не деградация: источник истины — локальная SQLite рядом с
# сервисом, генерация от наблюдательной машины не зависит вообще.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/БАЗА
STATS_PG_DSN=

# Файл локальной базы учёта. По умолчанию /root/stats.db — это каталог сервиса,
# смонтированный с хоста, поэтому база переживает пересборку образа (в отличие
# от кода, который в образ запечён).
STATS_DB=

# Как часто экспортёр пытается отвезти накопленное, секунды. По умолчанию 30.
STATS_EXPORT_INTERVAL=


# --------------------------------------------------------------------------
#  Буфер результатов
# --------------------------------------------------------------------------

# Готовые результаты лежат на диске, чтобы перезапуск не съедал чужую работу.
# По умолчанию /root/results.db — тот же смонтированный каталог.
RESULT_DB=

# Сколько часов держать результат после завершения задачи. По умолчанию 6.
#
# Выдача НЕ удаляет запись при чтении: обрыв ответа иначе терял бы готовую
# работу навсегда. Поэтому рост ограничен временем, а не поведением клиента.
# Замер: около мегабайта на задачу, то есть при двух тысячах задач в сутки шесть
# часов это полгигабайта. Хранить всё вечно нельзя — те же две тысячи в сутки
# дают под 700 ГБ в год.
RESULT_TTL_HOURS=

# Как часто подчищать просроченное, секунды. По умолчанию 600.
RESULT_SWEEP_INTERVAL=


# --------------------------------------------------------------------------
#  Пул карт и удалённые узлы
# --------------------------------------------------------------------------

# Удалённые узлы пула: JSON-список объектов {"name", "comfy"}.
# Пусто — пул только из локальных карт.
#
# Узел с одним адресом ComfyUI даёт ОДНУ карту (--cuda-device принимает одну) и
# умеет ТОЛЬКО видео: картинки и транскрипцию считает дочерний diffusers-процесс
# с CUDA_VISIBLE_DEVICES, а его на чужой машине не поднять.
#
# Потолок одновременных видео такому узлу НЕ задаётся руками: он считается из
# ram_total, который отдаёт его же /system_stats.
#
# VIDEO_NODES=[{"name":"llm-box","comfy":"http://ХОСТ:8188"}]
VIDEO_NODES=

# Потолок одновременных видео на весь пул. Пусто — сумма потолков узлов, и
# решает тогда потолок УЗЛА: оперативная память принадлежит машине, одно видео
# просит около 40 ГБ без --fast-disk и около 7 с ним. Число перекрывает расчёт,
# 0 снимает потолок совсем — но тогда лимит памяти не соблюдает никто, и машина
# уйдёт в своп.
MAX_CONCURRENT_VIDEO=


# --------------------------------------------------------------------------
#  Модели
# --------------------------------------------------------------------------

# Картиночная модель: z_image (по умолчанию) | chroma_flash | pornmaster.
# Реестр и параметры каждой — в IMAGE_MODELS в main.py.
IMAGE_MODEL=

# Модель правки изображений. По умолчанию qwen_edit.
EDIT_MODEL=


# --------------------------------------------------------------------------
#  Служебное, менять почти никогда не нужно
# --------------------------------------------------------------------------

# Каталог воркфлоу ComfyUI. По умолчанию comfy_workflows рядом с кодом.
COMFY_WORKFLOW_DIR=

# Кэш nf4-квантизации Wan для diffusers-отката. По умолчанию ~/.cache/wan_nf4.
QUANT_CACHE_DIR=
